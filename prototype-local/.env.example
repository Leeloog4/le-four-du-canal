# Node 24+, copie en .env. Local : aucune clé externe requise.
DATA_BACKEND=sqlite
DATABASE_PATH=./data/concours.sqlite
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DEMO_MODE=true
# Date FICTIVE : 4 décembre 2026, 15 h à Paris.
EVENT_AT=2026-12-04T14:00:00.000Z
EVENT_PLACE=Atelier du Canal, 12 rue des Gourmands, 75010 Paris (lieu fictif)
EMAIL_MODE=simulated
# Supabase : uniquement côté serveur. Aucun compte créé automatiquement.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# EMAIL_MODE=brevo exige ces trois valeurs. Ne pas utiliser de vraies adresses en démo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Le Four du Canal
# Secret long et aléatoire pour /api/cron/emails, jamais dans une URL.
CRON_SECRET=
